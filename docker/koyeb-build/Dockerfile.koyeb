# syntax=docker/dockerfile:1.4
FROM php:8.3-apache

WORKDIR /var/www/html

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# PHP dependencies
RUN apt-get update && apt-get install -y \
  git unzip libzip-dev libjpeg-dev libpng-dev libwebp-dev libxpm-dev \
  libfreetype6-dev libmagickwand-dev libicu-dev default-mysql-client \
  && docker-php-ext-configure gd --with-jpeg --with-webp --with-xpm --with-freetype \
  && docker-php-ext-install zip mysqli gd intl exif \
  && pecl install imagick \
  && docker-php-ext-enable imagick

# Apache on 8080 (Koyeb expects PORT=8080)
ENV APACHE_LISTEN_PORT=8080
RUN sed -i "s/Listen 80/Listen ${APACHE_LISTEN_PORT}/" /etc/apache2/ports.conf
ENV APACHE_RUN_USER=www-data
ENV APACHE_RUN_GROUP=www-data

# Enable rewrite and switch default vhost to :8080 with AllowOverride All
RUN a2enmod rewrite \
  && sed -i 's#<VirtualHost \*:80>#<VirtualHost *:8080>#g' /etc/apache2/sites-available/000-default.conf \
  && awk '1; /DocumentRoot \/var\/www\/html/ {print "\n    <Directory /var/www/html>\n        AllowOverride All\n        Require all granted\n    </Directory>\n"}' /etc/apache2/sites-available/000-default.conf > /tmp/000-default.conf \
  && mv /tmp/000-default.conf /etc/apache2/sites-available/000-default.conf

# Suppress Apache FQDN warning
RUN printf 'ServerName localhost\n' > /etc/apache2/conf-available/servername.conf \
  && a2enconf servername

# Fallback to index.php if .htaccess is ignored
RUN printf 'FallbackResource /index.php\n' > /etc/apache2/conf-available/fallback.conf \
  && a2enconf fallback || true

# In prod, we serve from the root /var/www/html
# (no /wordpress subdirectory)
RUN sed -i 's|DocumentRoot /var/www/html|DocumentRoot /var/www/html|g' /etc/apache2/sites-available/000-default.conf

# WP-CLI
RUN curl -sS -L https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar -o /usr/local/bin/wp \
  && chmod +x /usr/local/bin/wp

# Download and extract WordPress core without WP-CLI (avoids PHP memory limits during build)
RUN rm -rf /var/www/html/* \
  && curl -fsSL https://wordpress.org/latest.tar.gz -o /tmp/wordpress.tar.gz \
  && tar -xzf /tmp/wordpress.tar.gz -C /var/www/html --strip-components=1 \
  && rm -f /tmp/wordpress.tar.gz
ARG WWW_UID=33
ARG WWW_GID=33
RUN groupmod -o -g ${WWW_GID} www-data && \
    usermod  -o -u ${WWW_UID} -g ${WWW_GID} www-data && \
    chown -R www-data:www-data /var/www/html

# Ensure WordPress .htaccess exists with standard rules
RUN if [ ! -f /var/www/html/.htaccess ]; then \
      cat > /var/www/html/.htaccess <<'HTEND'
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
HTEND
    fi && \
    chown www-data:www-data /var/www/html/.htaccess && \
    chmod 644 /var/www/html/.htaccess

# Bundle DB CA certificate (provided in repo)
COPY ./docker/koyeb-build/ca.pem /etc/ssl/certs/mysql-ca.pem
RUN chmod 644 /etc/ssl/certs/mysql-ca.pem || true

# PHP-INI
COPY ./wordpress-config/custom.ini /usr/local/etc/php/conf.d/custom.ini

# === Optional: Drop ALL TABLES in target DB at build-time (TEST ONLY) ===
ARG MYSQL_HOST
ARG MYSQL_PORT
ARG MYSQL_USER
ARG MYSQL_PASSWORD
ARG MYSQL_DATABASE
ARG AIVEN_RESET_DB=0
RUN if [ "${AIVEN_RESET_DB}" = "1" ]; then \
      if [ -z "${MYSQL_HOST}" ] || [ -z "${MYSQL_PORT}" ] || [ -z "${MYSQL_USER}" ] || [ -z "${MYSQL_PASSWORD}" ] || [ -z "${MYSQL_DATABASE}" ]; then \
        echo "[ERROR] Missing required build args: MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE" >&2; \
        exit 2; \
      fi; \
      echo "Dropping ALL TABLES in ${MYSQL_DATABASE}@${MYSQL_HOST}:${MYSQL_PORT} …" && \
      MYSQL_PWD="${MYSQL_PASSWORD}" mysql \
        -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" \
        --protocol=TCP --batch --skip-column-names \
        -e "SET SESSION sql_notes=0; SET FOREIGN_KEY_CHECKS=0; SELECT CONCAT('DROP TABLE IF EXISTS \`', table_name, '\`;') FROM information_schema.tables WHERE table_schema='${MYSQL_DATABASE}'; SET FOREIGN_KEY_CHECKS=1;" \
      | MYSQL_PWD="${MYSQL_PASSWORD}" mysql \
          -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" \
          --protocol=TCP "${MYSQL_DATABASE}" \
      && echo "All tables dropped in ${MYSQL_DATABASE}."; \
    else \
      echo "AIVEN_RESET_DB!=1 → skipping table drop at build"; \
    fi
# === End optional reset ===

# Copy the project (including composer files)
COPY ./composer.json ./composer.lock ./
RUN composer install --prefer-dist --no-dev --no-scripts --no-interaction || true

# Copy themes and plugins from the root of the repository
COPY ./themes/ /var/www/html/wp-content/themes/
COPY ./plugins/ /var/www/html/wp-content/plugins/

# If necessary — demo files/scripts (do not perform auto-import!)
# COPY ./wordpress-config/demo /var/www/html/demo/

# Normalize .htaccess rules for root serving
RUN if [ -f /var/www/html/.htaccess ]; then \
      sed -i 's|RewriteBase /wordpress/|RewriteBase /|g; s|/wordpress/index.php|/index.php|g' /var/www/html/.htaccess || true; \
    fi

# Entrypoint: creates wp-config.php if it does not exist
COPY ./docker/koyeb-build/init-wordpress.sh /usr/local/bin/init-wordpress.sh
RUN chmod +x /usr/local/bin/init-wordpress.sh

# Permissions
RUN chown -R www-data:www-data /var/www/html && \
    find /var/www/html -type d -exec chmod 755 {} \; && \
    find /var/www/html -type f -exec chmod 644 {} \;

ENV PORT=8080
EXPOSE 8080

# Validate Apache config at build time
RUN apachectl -t || (cat /etc/apache2/apache2.conf && exit 1)

CMD ["/usr/local/bin/init-wordpress.sh"]